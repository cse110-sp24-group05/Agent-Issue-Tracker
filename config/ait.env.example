# Minimal template for the `ait` CLI — copy to .env in any project repo:
#   cp config/ait.env.example .env          (from this repo)
#   cp "$(npm root -g)/agent-issue-tracker/config/ait.env.example" .env   (global install)
#
# .env is gitignored — never commit AIT_USER_ID to a public repo.
# Get AIT_USER_ID from the web app: sign in → settings icon → Copy.

AIT_USER_ID=user-XXXXX
AIT_API_BASE=https://agent-issue-tracker.stc021.workers.dev

# Optional: agent id stored on claim (default: ait-agent-cc; registered automatically if new)
# AIT_AGENT_ID=ait-agent-cc
