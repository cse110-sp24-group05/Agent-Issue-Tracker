# Copy to .env and fill in values ( .env is gitignored )
#
# WHO READS WHAT:
#   Node CLI (simulator)     → AIT_API_BASE          via dotenv-cli (npm run sim)
#   AIT runner (global)      → AIT_*                 loaded from ~/.ait/.env (see below)
#   Wrangler CLI             → CLOUDFLARE_*          wrangler reads these automatically
#   GitHub Actions CD          → repo Secrets          NOT .env (CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID)
#   Browser UI (data.js)       → does NOT read .env    use localStorage ait_api_base or defaults in data.js
#   Worker runtime (deployed)  → .dev.vars (optional)  only if worker.js uses env bindings later
#
# --- GLOBAL INSTALL (run `ait` from any repo) ---
# 1. Install globally from this repo:
#      npm link                   # dev — symlinks from this repo
#      # or: npm install -g .     # installs a copy
#
# 2. Create your personal config file (only done once):
#      mkdir -p ~/.ait && cp .env.example ~/.ait/.env
#      # then edit ~/.ait/.env with your real values
#
# 3. Now `ait` works from any directory.
#    Config load order (highest priority first):
#      a. Shell env vars (export AIT_* in ~/.zshrc)
#      b. ~/.ait/.env   ← recommended for global use
#      c. .env in current working directory

# --- AIT API (Node tools: simulator, future runner) ---
# Local wrangler dev:
AIT_API_BASE=http://localhost:8787
# Or production Worker:
# AIT_API_BASE=https://agent-issue-tracker.stc021.workers.dev

# --- Cloudflare CLI (optional if you already ran `npx wrangler login`) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Local static UI (reference only; npm run dev uses port 8080 in package.json) ---
AIT_UI_PORT=8080

# --- AIT Runner (`ait` CLI — scopes issues to your account) ---
# Copy this line from the web app: settings icon (top right) → Copy.
# Must match the account you use to create issues in the UI.
AIT_USER_ID=user-XXXXX
# Optional: label sent when claiming an issue.
AIT_AGENT_ID=ait-agent-cc-01
