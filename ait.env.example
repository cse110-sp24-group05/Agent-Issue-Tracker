# Copy to .env in your project root:
#   cp ait.env.example .env
#
# .env is gitignored — never commit AIT_USER_ID to a public repo.
# Get AIT_USER_ID from the web app: sign in → settings icon → Copy.

AIT_USER_ID=user-XXXXX
AIT_API_BASE=https://agent-issue-tracker.stc021.workers.dev

# Optional: label recorded when claiming an issue
# AIT_AGENT_ID=ait-agent-cc-01
