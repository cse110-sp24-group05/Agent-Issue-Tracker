{
  "type": "module",
  "bin": {
    "ait": "src/runner/runner.js"
  },
  "scripts": {
    "dev": "python3 -m http.server 8080 --directory src",
    "dev:api": "dotenv -e .env -- wrangler dev",
    "ait": "dotenv -e .env -- node src/runner/runner.js",
    "sim": "dotenv -e .env -- node src/runner/simulator.js",
    "ait-runner": "dotenv -e .env -- node src/runner/claude-runner.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transform": {}
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@jest/globals": "^29.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsdoc": "^48.0.0",
    "jest": "^30.4.2",
    "wrangler": "^4.92.0"
  },
  "version": "1.4.0",
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
